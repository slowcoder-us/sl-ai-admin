{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sl-ai-admin-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true
}
