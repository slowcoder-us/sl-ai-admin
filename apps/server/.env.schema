# @optional @type=string(minLength=1)
DB_HOST=
# @optional @type=string(minLength=1)
DB_NAME=
# @optional @type=string(minLength=1)
DB_USER=
# @optional @type=string(minLength=1)
DB_PASSWORD=
# @optional @type=string(minLength=1)
APP_DB_PASSWORD=
